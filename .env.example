# Neon (pooled) connection string. The app uses the pooled driver, so a
# -pooler host works for both app queries and drizzle-kit.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# Base URL of the deployment (local dev default shown).
NEXTAUTH_URL=http://localhost:3000

# Legacy secret name (kept for compatibility).
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32

# Auth.js v5 secret (required).
AUTH_SECRET=generate-with-openssl-rand-base64-32
