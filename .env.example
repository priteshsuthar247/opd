# Neon connection string. The app uses the pooled WS driver (Neon
# serverless pool), so use the -pooler host for DATABASE_URL.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler/neondb?sslmode=require

# Auth.js v5: exactly one secret and one URL. NEXTAUTH_* names are NOT
# read by the app and are kept out to avoid ambiguity.
AUTH_SECRET=generate-with-openssl-rand-base64-32
AUTH_URL=http://localhost:3000

# Demo seeding (dev only). seed.ts refuses to run with
# NODE_ENV=production unless this is explicitly set to 1.
SEED_DEMO=

# Outgoing mail for OTP password resets (nodemailer). Either the full
# SMTP set or the Gmail shorthand (app password) — SMTP_* wins if both
# are present.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=you@example.com
SMTP_PASS=secret
MAIL_FROM="OPD Clinic <no-reply@example.com>"
# MY_EMAIL=you@gmail.com
# EMAIL_PASSWORD=xxxx-xxxx-xxxx-xxxx
